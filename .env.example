# Required at startup
# OPENAI_TEXT_MODEL intentionally has no code fallback so production can roll
# back without a release. Storyboard's verified target is GPT-5.6 Luna.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Required by the Supabase-backed product areas
# The service role key is server-only and must never enter public/browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# Required by Image to Prompt
GEMINI_API_KEY=

# Required by Paddle billing and webhook synchronization
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Stable USD 9.99 Pro price. Keep this ID permanently so existing subscribers
# continue renewing and so disabling the staged cutover is a safe rollback.
PADDLE_PRO_PRICE_ID=
PADDLE_ENTERPRISE_PRICE_ID=
# New-subscription cutover only. When false, public pricing and outbound Pro
# checkout remain on PADDLE_PRO_PRICE_ID at USD 9.99. When true, the server
# fails closed unless PADDLE_PRO_1099_PRICE_ID is present and distinct, then
# exposes that ID at USD 10.99 while retaining PADDLE_PRO_PRICE_ID inbound.
PRO_PRICE_1099_ENABLED=false
PADDLE_PRO_1099_PRICE_ID=
# Additional inbound webhook compatibility only. The stable USD 9.99 and
# staged USD 10.99 IDs are retained automatically; list any still-older IDs
# here. Browser checkout and plan changes use only the flag-selected ID.
PADDLE_PRO_LEGACY_PRICE_IDS=
PADDLE_ENTERPRISE_LEGACY_PRICE_IDS=
# Read-only catalog-audit gates used only while PRO_PRICE_1099_ENABLED=true.
# Do not assume the stable USD 9.99 price should be archived: set its expected
# status to active or archived only after Paddle confirms the renewal behavior.
PADDLE_PRO_999_EXPECTED_STATUS=
# Exact JSON map for every ID in PADDLE_PRO_LEGACY_PRICE_IDS, for example:
# {"pri_old":{"unitAmount":"899","status":"archived","productStatus":"active"}}
PADDLE_PRO_LEGACY_PRICE_EXPECTATIONS={}

# Dormant one-time usage add-on foundation.
# Keep both flags false until Paddle gives written policy approval, migrations
# 023 through 026 are applied, Sandbox E2E passes, and public/legal copy is
# activated. Add-ons are server-created immediate subscription charges with
# transaction-specific non-catalog prices; there are intentionally no reusable
# active add-on Price IDs for Paddle.js.
CREDIT_LEDGER_V2_ENABLED=false
CREDIT_PACK_PURCHASES_ENABLED=false
CREDIT_PACK_EXPIRY_DAYS=365
# Must be explicitly confirmed with Paddle for this product before enabling.
PADDLE_CREDIT_PACK_TAX_CATEGORY=
# Set true only after Paddle confirms the exact category above in writing.
PADDLE_CREDIT_PACK_TAX_CATEGORY_CONFIRMED=false
# Set true only after the server API key has subscription_history.read and a
# Sandbox history request has succeeded. Fulfillment fails closed without it.
PADDLE_SUBSCRIPTION_HISTORY_CONFIRMED=false
# Set true only after the server/reconciliation API key has subscription.read
# plus transaction.read and a complete paginated Sandbox transaction scan has
# succeeded. Reconciliation --apply additionally requires a modern live key
# whose pdl_live_apikey_ prefix matches https://api.paddle.com.
PADDLE_TRANSACTION_READ_CONFIRMED=false
# If older reusable add-on Price IDs were ever created, list them here. The
# read-only audit requires every listed legacy price to be archived.
PADDLE_CREDIT_PACK_600_LEGACY_PRICE_IDS=
PADDLE_CREDIT_PACK_1500_LEGACY_PRICE_IDS=
PADDLE_CREDIT_PACK_3000_LEGACY_PRICE_IDS=

# Optional validation policy
# Leave false for backward-compatible feature warnings. Enable only after all
# feature-required values above are confirmed in the deployment environment.
ENV_VALIDATION_STRICT_FEATURES=false

# Application — optional defaults
NODE_ENV=development
PORT=3000
SERVICE_NAME=promptgen-api
# Used by the standalone read-only smoke command, not by the web server.
APP_URL=http://localhost:3000
PUBLIC_ASSET_VERSION=

# AI provider defaults
OPENAI_TEXT_REASONING_EFFORT=medium
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_MODEL=gemini-3.1-flash-lite
# Prompt contract version for telemetry and an env-only rollback.
GEMINI_ANALYSIS_PROMPT_VERSION=image-analysis-v2-spatial-fidelity
# Dormant canary. Keep false until a paid Gemini validation budget is approved.
GEMINI_STRUCTURED_OUTPUT_ENABLED=false
# Observability-only Sharp metadata canary. It never resizes the Gemini input.
GEMINI_IMAGE_METADATA_SHADOW_ENABLED=false
# When enabled, inspect 5% of requests with at most one Sharp job per process.
GEMINI_IMAGE_METADATA_SHADOW_SAMPLE_RATE=0.05
GEMINI_IMAGE_METADATA_SHADOW_MAX_CONCURRENCY=1

# Paddle defaults/public checkout configuration
PADDLE_API_BASE=https://api.paddle.com
# Optional because the current public catalog has a deployed public-token
# fallback. Prefer setting it explicitly for rotation and environment clarity.
PADDLE_CLIENT_TOKEN=
# Compatibility marker for the stable catalog. Keep at 9.99; the staged
# USD 10.99 amount is derived only from PRO_PRICE_1099_ENABLED.
PADDLE_PRO_PRICE_USD=9.99
PADDLE_ENTERPRISE_PRICE_USD=19.99
TEST_ACCOUNT_USER_IDS=

# Durable Storyboard worker
STORYBOARD_ALLOWED_PLANS=pro,enterprise,paid
STORYBOARD_DURABLE_WORKER_ENABLED=true
STORYBOARD_WORKER_CONCURRENCY=5
STORYBOARD_WORKER_POLL_MS=5000
STORYBOARD_WORKER_LEASE_SECONDS=180
STORYBOARD_WORKER_HEARTBEAT_MS=60000
STORYBOARD_RETRY_BASE_SECONDS=15
STORYBOARD_MAX_ATTEMPTS=3
STORYBOARD_MAX_CONCURRENT_JOBS=5
STORYBOARD_MAX_FILE_SIZE_MB=10
STORYBOARD_RATE_LIMIT_SECONDS=60
STORYBOARD_REF_EXPIRY_BUFFER_MINUTES=10
# Grace period before permanently deleting an already soft-deleted storyboard.
# Active storyboard results and grid images are available for 90 days (migration 016).
STORYBOARD_RETENTION_DAYS=30

# Storage-aware cleanup scheduler
CLEANUP_SCHEDULER_ENABLED=true
CLEANUP_INITIAL_DELAY_MS=60000
CLEANUP_INTERVAL_MS=86400000
CLEANUP_BATCH_SIZE=100
WEBHOOK_EVENT_RETENTION_DAYS=90

# Optional external incident delivery
# All formats intentionally omit message, context, fingerprints, and identifiers.
# generic: {severity,eventCode}; slack: {text}; discord: {content}
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_FORMAT=generic
OPS_ALERT_MIN_SEVERITY=critical
OPS_ALERT_REPEAT=false
