{
  "name": "prompt-generator",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:e2e": "playwright test tests/e2e",
    "test": "npm run test:unit && npm run test:e2e",
    "generate:og": "node scripts/generate-og-images.js",
    "cleanup": "node scripts/daily-cleanup.js",
    "cleanup:dry-run": "node scripts/daily-cleanup.js --dry-run",
    "audit:paddle-catalog": "node scripts/audit-paddle-catalog.js",
    "audit:paddle-credit-packs": "node scripts/audit-credit-pack-catalog.js",
    "audit:credit-policy-v2": "node scripts/audit-credit-policy-v2.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@google/genai": "2.13.0",
    "@supabase/supabase-js": "^2.99.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "multer": "^2.2.0",
    "openai": "^6.36.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "jest": "30.4.2",
    "nodemon": "^3.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "gaxios": "7.3.0",
    "minimatch": "10.2.4",
    "test-exclude": "8.0.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
